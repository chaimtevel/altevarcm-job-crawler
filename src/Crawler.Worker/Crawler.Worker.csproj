<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Crawler.Domain\Crawler.Domain.csproj" />
    <ProjectReference Include="..\Crawler.Infrastructure\Crawler.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AngleSharp over HtmlAgilityPack: HTML5-spec parser, handles malformed markup like browsers do. -->
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <PackageReference Include="Dapr.AspNetCore" Version="1.18.10" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
