# Copy to .env (gitignored) and set real values before running `docker compose up`.
# Local/demo credentials only; use a secret manager for real deployments.
POSTGRES_DB=crawler
POSTGRES_USER=crawler
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=crawler
RABBITMQ_PASSWORD=change-me

# Shared secrets: apps → Dapr sidecar, and sidecar → worker message endpoint.
DAPR_API_TOKEN=change-me
APP_API_TOKEN=change-me
